# =============================================================================
# Linux Broker for AVD Access — Environment Variables Template
# =============================================================================
#
# This file documents ALL required environment variables across all components.
# Copy this file to .env and fill in your values before deployment.
#
# DEPLOYMENT ORDER:
#   1. Deploy infrastructure (Bicep) — produces resource IDs, URLs
#   2. Register app in Azure AD — produces CLIENT_ID, TENANT_ID, secrets
#   3. Configure API App Service settings (this file, "API" section)
#   4. Configure Azure Functions settings (this file, "Functions" section)
#   5. Deploy custom script extensions with Broker Agent variables
#   6. Deploy Linux host scripts with Session Release Agent variables
#
# =============================================================================


# =============================================================================
# COMPONENT: Broker API  (Azure App Service)
# Set these as App Service > Configuration > Application Settings
# =============================================================================

# --- Azure AD / Authentication ---

# Azure AD Tenant ID where the app registration lives
TENANT_ID="your-azure-ad-tenant-id"

# App Registration (API) Client ID — the Application (client) ID from Azure AD
CLIENT_ID="your-api-app-registration-client-id"

# App Registration secret for Microsoft Auth Provider (used by Portal auth flow)
# Created during app registration — store securely, rotate regularly
MICROSOFT_PROVIDER_AUTHENTICATION_SECRET="your-app-registration-secret"

# --- Azure Resource Configuration ---

# Subscription ID where Linux VMs are deployed
VM_SUBSCRIPTION_ID="your-azure-subscription-id"

# Resource Group containing the Linux VMs
VM_RESOURCE_GROUP="your-linux-vm-resource-group"

# Azure AD Security Group ID for AVD Session Hosts (grants AVDHost API role)
AVD_HOST_GROUP_ID="your-avd-host-security-group-id"

# Azure AD Security Group ID for Linux VMs (grants LinuxHost API role)
LINUX_HOST_GROUP_ID="your-linux-host-security-group-id"

# Admin login name used on Linux VMs (for SSH/management operations)
LINUX_HOST_ADMIN_LOGIN_NAME="avdadmin"

# --- Microsoft Graph API ---

# Microsoft Graph API scope for app-level access
GRAPH_API_ENDPOINT="https://graph.microsoft.com/.default"

# Azure AD domain name (e.g., contoso.onmicrosoft.com)
DOMAIN_NAME="your-domain.onmicrosoft.com"

# --- Database Configuration ---

# Azure SQL Server hostname (e.g., your-server.database.windows.net)
DB_SERVER="your-sql-server.database.windows.net"

# Database name on the SQL server
DB_DATABASE="LinuxBrokerDB"

# SQL admin username for database connections
DB_USERNAME="your-sql-admin-username"

# --- Azure Key Vault ---

# Key Vault URI (e.g., https://your-vault.vault.azure.net/)
VAULT_URL="https://your-keyvault-name.vault.azure.net/"

# Name of the secret in Key Vault that stores the DB password
DB_PASSWORD_NAME="db-password"

# Name of the secret in Key Vault that stores the SSH PEM key
KEY_NAME="your-pem-key-secret-name"

# --- NFS Configuration ---

# NFS share path for user profile storage (e.g., nfs-server:/export/profiles)
NFS_SHARE="your-nfs-server:/export/profiles"

# --- Deployment / Monitoring (auto-set by Azure, but listed for reference) ---

# Set to "true" to enable build during zip deployment
# SCM_DO_BUILD_DURING_DEPLOYMENT="true"

# Application Insights connection string (auto-populated if App Insights is linked)
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=...;IngestionEndpoint=...;LiveEndpoint=..."


# =============================================================================
# COMPONENT: Azure Functions  (Timer-triggered scaling & monitoring tasks)
# Set these as Function App > Configuration > Application Settings
# =============================================================================

# App Registration (API) Client ID — same as above, used to acquire tokens
API_CLIENT_ID="your-api-app-registration-client-id"

# Base URL of the Broker API (e.g., https://your-broker-app.azurewebsites.net/api)
API_URL="https://your-broker-api.azurewebsites.net/api"

# Azure Functions runtime (do not change)
# FUNCTIONS_WORKER_RUNTIME="python"

# Azure Functions version (do not change)
# FUNCTIONS_EXTENSION_VERSION="~4"

# Storage account connection string for Azure Functions runtime
# AzureWebJobsStorage="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# Application Insights connection string for Functions monitoring
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=...;IngestionEndpoint=...;LiveEndpoint=..."


# =============================================================================
# COMPONENT: Broker Agent  (PowerShell on AVD Session Hosts)
# These values are injected by the Configure-AVD-Host.ps1 custom script extension
# =============================================================================

# Base URL of the Broker API — passed as -LinuxBrokerApiBaseUrl parameter
# to Configure-AVD-Host.ps1, which writes it into Connect-LinuxBroker.ps1
# BROKER_AGENT_API_BASE_URL="https://your-broker-api.azurewebsites.net/api"

# API App Registration Client ID — written into Connect-LinuxBroker.ps1
# as the resource URI for managed identity token acquisition
# BROKER_AGENT_API_CLIENT_ID="your-api-app-registration-client-id"


# =============================================================================
# COMPONENT: Session Release Agent  (Bash on Linux VMs)
# These values are injected by the Configure-*-Host.sh custom script extensions
# via sed replacement into release-session.sh
# =============================================================================

# API Client ID — replaced into YOUR_LINUX_BROKER_API_CLIENT_ID placeholder
# YOUR_LINUXBROKER_API_CLIENT_ID="your-api-app-registration-client-id"

# API Base URL — replaced into YOUR_LINUX_BROKER_API_URL placeholder
# YOUR_LINUXBROKER_API_URL="https://your-broker-api.azurewebsites.net/api"

# RHEL Subscription Manager Org ID (RHEL hosts only)
# ORG_ID="your-rhel-org-id"

# RHEL Subscription Manager Activation Key (RHEL hosts only)
# ACTIVATION_KEY="your-rhel-activation-key"
