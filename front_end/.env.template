# =============================================================================
# Linux Broker Service Management Portal — Environment Variables
# =============================================================================
# Copy this file to .env (for local dev) or set these in Azure App Service
# Configuration > Application Settings.
#
# All variables marked [REQUIRED] must be set or the app will refuse to start.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment (Azure App Service)
# -----------------------------------------------------------------------------
# Tells App Service to run pip install during ZIP deployment.
SCM_DO_BUILD_DURING_DEPLOYMENT="true"

# -----------------------------------------------------------------------------
# Application Configuration [REQUIRED]
# -----------------------------------------------------------------------------
# Secret key used by Flask for signing session cookies. Generate a random string.
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_KEY="your_flask_secret_key"

# -----------------------------------------------------------------------------
# Azure AD / Entra ID Authentication [REQUIRED]
# -----------------------------------------------------------------------------
# Client (application) ID of the **frontend** app registration in Azure AD.
CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Azure AD tenant ID.
TENANT_ID="00000000-0000-0000-0000-000000000000"

# Client secret for the frontend app registration.
MICROSOFT_PROVIDER_AUTHENTICATION_SECRET="your_client_secret"

# Comma-separated list of allowed Azure AD tenant IDs (App Service auth).
WEBSITE_AUTH_AAD_ALLOWED_TENANTS="00000000-0000-0000-0000-000000000000"

# -----------------------------------------------------------------------------
# Linux Broker API Connection [REQUIRED]
# -----------------------------------------------------------------------------
# Base URL of the Linux Broker API (include /api path).
# This is the Azure App Service URL where the API is deployed.
API_URL="https://your-linuxbroker-api.azurewebsites.net/api"

# Client (application) ID of the **API** app registration in Azure AD.
# Used to construct the API scope for token acquisition.
API_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# -----------------------------------------------------------------------------
# Application Insights (Optional but recommended)
# -----------------------------------------------------------------------------
# Connection string from your Application Insights resource.
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://eastus-0.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus.livediagnostics.monitor.azure.com/;ApplicationId=00000000-0000-0000-0000-000000000000"

# Enable the Application Insights agent extension.
ApplicationInsightsAgent_EXTENSION_VERSION="~3"
APPLICATIONINSIGHTSAGENT_EXTENSION_ENABLED="true"

# Number of days to retain HTTP logs.
WEBSITE_HTTPLOGGING_RETENTION_DAYS="7"
